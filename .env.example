# Supabase (ya usado por el resto del backend)
SUPABASE_URL=
SUPABASE_KEY=

# Connekta — cliente SIESA (módulo /api/siesa)
CONNEKTA_BASE_URL=
CONNEKTA_ID_COMPANIA=
CONNI_KEY=
CONNI_TOKEN=
CONNEKTA_MAX_INTENTOS=4

# Sincronización SIESA -> dotaciones
SIESA_CONSULTA_EMPLEADOS=merkahorro_empleados_activos
SIESA_SYNC_TTL_MIN=60
SIESA_SYNC_MIN_INTERVAL_SEC=60
SIESA_MIN_EMPLEADOS=200
# Días desde created_at durante los cuales una dotación nueva NUNCA se
# auto-desactiva por ausencia en SIESA (RRHH registra el contrato después
# del ingreso, no antes).
SIESA_GRACIA_DIAS=30
